# ==============================================================================
# GenCanvas AI Studio - Server Environment Configuration Template
# Copy this file to .env and configure your local or cloud environment variables.
# NEVER commit your actual .env file with production credentials to source control.
# ==============================================================================

# Server Port
PORT=8080

# Environment Mode: development | production | test
NODE_ENV=development

# CORS Allowed Origins (Comma-separated URLs for web clients)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MongoDB Database Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/gencanvas
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gencanvas?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/gencanvas

# JWT Secret Key for Authenticating API Requests (Generate a high-entropy string)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Optional: Cloudinary Credentials (Used for CDN storage of shared community creations)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: OpenAI API Key (For OpenAI DALL-E image generation engine)
# Note: GenCanvas AI includes built-in high-performance Pollinations AI (Flux) as the default free engine.
OPENAI_API_KEY=your_openai_api_key_optional
